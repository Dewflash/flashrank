# Public App Store lookup/search does not require keys.
# Copy this file to .env.local when you have private Apple credentials.

# App Store Connect API
# Create in App Store Connect > Users and Access > Integrations > App Store Connect API.
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Apple Search Ads / Apple Ads API
# Create in Apple Search Ads / Apple Ads account settings when API access is available.
APPLE_SEARCH_ADS_CLIENT_ID=
APPLE_SEARCH_ADS_TEAM_ID=
APPLE_SEARCH_ADS_KEY_ID=
APPLE_SEARCH_ADS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# DeepL API
# Optional. DeepL API Free supports a limited monthly character allowance.
DEEPL_AUTH_KEY=
